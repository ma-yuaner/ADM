# mock：本地演示数据；repo：复用data-team-repo的erp_config；mysql：使用下面环境变量
ADM_DATA_MODE=mock

# 只有测试环境确认后才能设为true；mock模式始终允许原型内修改
ADM_WRITE_ENABLED=false
ADM_DEFAULT_PERSON=黄娜娟
ADM_OPERATOR_ID=0

ADM_HOST=0.0.0.0
ADM_PORT=5050
ADM_DEBUG=false
ADM_LOG_LEVEL=INFO

# ADM_DATA_MODE=mysql时必填
ADM_DB_HOST=
ADM_DB_PORT=3306
ADM_DB_USER=
ADM_DB_PASSWORD=
ADM_DB_DATABASE=sibedb

ADM_EXPORT_PROFILES=config/export_profiles.json

# 企业微信群机器人：发送到指定群并@所选人员，默认关闭
ADM_WECOM_SEND_ENABLED=false
ADM_WECOM_WEBHOOK_URL=
ADM_WECOM_PEOPLE_FILE=config/wecom_people.json
# 推荐直接在服务器.env配置，姓名必须与页面人员姓名一致
ADM_WECOM_PEOPLE_JSON={}
